<IfModule mod_rewrite.c>
    RewriteEngine on

    RewriteRule ^(?:\.env(?:\..*)?|\.git(?:/|$)|composer\.(?:json|lock)$|artisan$|package\.json$|phpunit\.xml$|vite\.config\.js$) - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor)(?:/|$) - [F,L]
    RewriteRule ^storage/(?:framework|logs)(?:/|$) - [F,L]
    RewriteRule ^storage/.*\.(?:php|phtml|phar|php5|php7|php8)$ - [F,L]

    RewriteCond %{REQUEST_URI} !^public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>